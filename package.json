{
	"name": "DD2CSVMMD",
	"description": "CSV Language support for modding Darkest Dungeon 2",
	"author": "dnauu-bmsotc",
	"license": "MIT",
	"version": "1.0.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/dnauu-bmsotc/VSC-DD2-CSV-MMD"
	},
	"publisher": "vscode-samples",
	"categories": [],
	"keywords": [
	],
	"engines": {
		"vscode": "^1.100.0"
	},
	"activationEvents": [
		"onLanguage:csv"
	],
	"main": "./client/out/extension",
	"contributes": {
		"languages": [
			{
				"id": "DD2MMD"
			}
		],
		"grammars": [
			{
				"language": "DD2MMD",
				"scopeName": "source.DD2MMD",
				"path": "./syntaxes/DD2MMD.tmGrammar.json"
			}
		],
		"configuration": {
			"type": "object",
			"title": "DD2 CSV MMD configuration",
			"properties": {
				"DD2CSVMMD.languageDetectionMethod": {
					"type": "string",
					"default": "firstLine",
					"description": "Which files the extension will process",
					"enum": [
						"firstLine",
						"allCsv"
					],
					"enumItemLabels": [
						"element_start in the first line",
						"All CSV files"
					],
					"markdownEnumDescriptions": [
						"Only enable extension for CSV files that have element_start in the first line.",
						"Enable extension for all CSV files."
					]
				},
				"DD2CSVMMD.tokenColors": {
					"type": "string",
					"default": "mmd",
					"description": "Syntax highlight colors",
					"enum": [
						"phombie",
						"mmd",
						"none"
					],
					"enumItemLabels": [
						"PHombie",
						"Alternative",
						"None"
					],
					"markdownEnumDescriptions": [
						"Use syntax highlight colors defined by PHombie.",
						"Use alternative syntax highlight colors.",
						"Don't use syntax highlight overrides."
					]
				},
				"DD2CSVMMD.validateElementBoundaries": {
					"type": "boolean",
					"default": true,
					"description": "Show mismatched element_start and element_end lines."
				},
				"DD2CSVMMD.validateElementTypes": {
					"type": "boolean",
					"default": true,
					"description": "Show unrecognized element types."
				},
				"DD2CSVMMD.validateFieldNames": {
					"type": "boolean",
					"default": true,
					"description": "Show unrecognized field names."
				},
				"DD2CSVMMD.validateFieldInput": {
					"type": "boolean",
					"default": true,
					"description": "Validate inputs of fields"
				},
				"DD2CSVMMD.devMode": {
					"type": "boolean",
					"default": false,
					"description": "Rebuild data and readme on extension start"
				}
			}
		}
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -b",
		"watch": "tsc -b -w",
		"lint": "eslint",
		"postinstall": "cd client && npm install && cd ../server && npm install && cd ..",
		"test": "sh ./scripts/e2e.sh"
	},
	"devDependencies": {
		"@eslint/js": "^9.13.0",
		"@stylistic/eslint-plugin": "^2.9.0",
		"@types/mocha": "^10.0.6",
		"@types/node": "^22",
		"eslint": "^9.13.0",
		"mocha": "^10.3.0",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.39.0"
	},
	"dependencies": {
		"xlsx": "^0.18.5"
	}
}
