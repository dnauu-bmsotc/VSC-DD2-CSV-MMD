{
	"name": "DD2CSVMMD",
	"description": "CSV Language support for modding Darkest Dungeon 2",
	"author": "dnauu-bmsotc",
	"license": "MIT",
	"version": "1.0.1",
	"repository": {
		"type": "git",
		"url": "https://github.com/dnauu-bmsotc/VSC-DD2-CSV-MMD"
	},
	"publisher": "dnauu",
	"icon": "images/icon128.png", 
	"categories": [],
	"keywords": [
	],
	"engines": {
		"vscode": "^1.100.0"
	},
	"activationEvents": [
		"onLanguage:DD2MMD"
	],
	"main": "./client/out/client/src/extension",
	"contributes": {
		"languages": [
			{
				"id": "DD2MMD",
				"aliases": ["DD2 CSV"],
				"filenamePatterns": ["**/*.Group.csv"]
			}
		],
		"grammars": [
			{
				"language": "DD2MMD",
				"scopeName": "source.DD2MMD",
				"path": "./syntaxes/DD2MMD.tmGrammar.json"
			}
		],
		"configuration": {
			"type": "object",
			"title": "DD2 CSV MMD configuration",
			"properties": {
				"DD2CSVMMD.syntaxColors": {
					"type": "string",
					"default": "mmd",
					"description": "Syntax highlight color overrides",
					"enum": [
						"phombie",
						"mmd",
						"none"
					],
					"enumItemLabels": [
						"PHombie",
						"Alternative",
						"None"
					],
					"markdownEnumDescriptions": [
						"Use syntax highlight colors defined by PHombie.",
						"Use alternative syntax highlight colors.",
						"Don't use syntax highlight overrides."
					]
				},
				"DD2CSVMMD.externalDirectories": {
					"type": "array",
					"description": "External directories containing DD2 CSV files.",
					"items": {
						"type": "string"
					},
					"default": [
						"C:/Program Files (x86)/Steam/steamapps/common/Darkest Dungeon® II/Darkest Dungeon II_Data/StreamingAssets/Excel",
						"C:/Program Files/Epic Games/DarkestDungeonII/Darkest Dungeon II_Data/StreamingAssets/Excel",
						"~/Library/Application Support/Steam/steamapps/common/Darkest Dungeon® II/Contents/Resources/Data/StreamingAssets/Excel",
						"C:/GOG Games/Darkest Dungeon II/Darkest Dungeon II_Data/StreamingAssets"
					]
				},
				"DD2CSVMMD.features": {
					"type": "object",
					"title": "Enabled Features",
					"description": "Toggle features.",
					"additionalProperties": false,
					"default": {
						"autocomplete": true,
						"semanticHighlighting": true,
						"hintsOnHover": true,
						"validationComments": true,
						"validationElementBoundary": true,
						"validationElementType": true,
						"validationFieldName": true,
						"validationFieldValues": true,
						"validationAddables": true,
						"validationWhitespace": true,
						"validationUnusedElements": true
					},
					"properties": {
						"autocomplete": {
							"type": "boolean",
							"description": "Enable completion suggestions."
						},
						"semanticHighlighting": {
							"type": "boolean",
							"description": "Highlight ID/tag references and keyword values."
						},
						"hintsOnHover": {
							"type": "boolean",
							"description": "Show hints when hovered over fields and values."
						},
						"validationComments": {
							"type": "boolean",
							"description": "Warn about lines that start with // or #."
						},
						"validationElementBoundary": {
							"type": "boolean",
							"description": "Show mismatched element_start and element_end lines."
						},
						"validationElementType": {
							"type": "boolean",
							"description": "Show unrecognized element types."
						},
						"validationFieldName": {
							"type": "boolean",
							"description": "Show unrecognized field names."
						},
						"validationFieldValues": {
							"type": "boolean",
							"description": "Validate inputs of fields."
						},
						"validationAddables": {
							"type": "boolean",
							"description": "Warn about repeating non-addable elements with the same type and ID."
						},
						"validationWhitespace": {
							"type": "boolean",
							"description": "Warn about whitespaces."
						},
						"validationUnusedElements": {
							"type": "boolean",
							"description": "Warn about unused elements."
						}
					}
				}
			}
		}
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -b",
		"watch": "tsc -b -w",
		"lint": "eslint",
		"postinstall": "cd client && npm install && cd ../server && npm install && cd ..",
		"test": "sh ./scripts/e2e.sh"
	},
	"devDependencies": {
		"@eslint/js": "^9.13.0",
		"@stylistic/eslint-plugin": "^2.9.0",
		"@types/mocha": "^10.0.6",
		"@types/node": "^22",
		"eslint": "^9.13.0",
		"mocha": "^10.3.0",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.39.0"
	},
	"dependencies": {
		"xlsx": "^0.18.5"
	}
}
