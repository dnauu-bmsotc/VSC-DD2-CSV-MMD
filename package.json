{
	"name": "DD2CSVMMD",
	"description": "CSV Language support for modding Darkest Dungeon 2",
	"author": "dnauu-bmsotc",
	"license": "MIT",
	"version": "1.0.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/dnauu-bmsotc/VSC-DD2-CSV-MMD"
	},
	"publisher": "vscode-samples",
	"categories": [],
	"keywords": [
	],
	"engines": {
		"vscode": "^1.100.0"
	},
	"activationEvents": [
		"onLanguage:DD2MMD"
	],
	"main": "./client/out/client/src/extension",
	"contributes": {
		"languages": [
			{
				"id": "DD2MMD",
				"aliases": ["DD2 CSV"],
				"filenamePatterns": ["**/*.Group.csv"]
			}
		],
		"grammars": [
			{
				"language": "DD2MMD",
				"scopeName": "source.DD2MMD",
				"path": "./syntaxes/DD2MMD.tmGrammar.json"
			}
		],
		"configuration": {
			"type": "object",
			"title": "DD2 CSV MMD configuration",
			"properties": {
				"DD2CSVMMD.tokenColors": {
					"type": "string",
					"default": "mmd",
					"description": "Syntax highlight colors",
					"enum": [
						"phombie",
						"mmd",
						"none"
					],
					"enumItemLabels": [
						"PHombie",
						"Alternative",
						"None"
					],
					"markdownEnumDescriptions": [
						"Use syntax highlight colors defined by PHombie.",
						"Use alternative syntax highlight colors.",
						"Don't use syntax highlight overrides."
					]
				},
				"DD2CSVMMD.validateElementBoundaries": {
					"type": "boolean",
					"default": true,
					"description": "Show mismatched element_start and element_end lines."
				},
				"DD2CSVMMD.validateElementTypes": {
					"type": "boolean",
					"default": true,
					"description": "Warn about unrecognized element types."
				},
				"DD2CSVMMD.validateFieldNames": {
					"type": "boolean",
					"default": true,
					"description": "Warn about unrecognized field names."
				},
				"DD2CSVMMD.validateFieldInput": {
					"type": "boolean",
					"default": true,
					"description": "Validate inputs of fields."
				},
				"DD2CSVMMD.showEmptyFields": {
					"type": "boolean",
					"default": false,
					"description": "Warn about empty element lines."
				},
				"DD2CSVMMD.allowComments": {
					"type": "boolean",
					"default": false,
					"description": "Do not mark lines that start with // or # as errors."
				},
				"DD2CSVMMD.DD2ExcelDirs": {
					"type": "array",
					"description": "Directories containing DD2 CSV vanilla data (used in dev mode).",
					"items": {
						"type": "string"
					},
					"default": [
						"C:/Program Files (x86)/Steam/steamapps/common/Darkest Dungeon® II/Darkest Dungeon II_Data/StreamingAssets/Excel",
						"C:/Program Files/Epic Games/DarkestDungeonII/Darkest Dungeon II_Data/StreamingAssets/Excel",
						"~/Library/Application Support/Steam/steamapps/common/Darkest Dungeon® II/Contents/Resources/Data/StreamingAssets/Excel"
					]
				},
				"DD2CSVMMD.indexProjectFiles": {
					"type": "boolean",
					"default": true,
					"description": "Use indexes from all .Group.CSV files in the project (collect IDs and tags from other files in the project)."
				},
				"DD2CSVMMD.validateProjectFiles": {
					"type": "boolean",
					"default": true,
					"description": "Validate all .Group.CSV files in the project (show errors in closed files)."
				},
				"DD2CSVMMD.devMode": {
					"type": "boolean",
					"default": false,
					"description": "Rebuild data and readme on extension start."
				},
				"DD2CSVMMD.debounceTime": {
					"type": "integer",
					"default": 100,
					"minimum": 0,
					"maximum": 10000,
					"description": "Debounce time for validation in milliseconds."
				}
			}
		}
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -b",
		"watch": "tsc -b -w",
		"lint": "eslint",
		"postinstall": "cd client && npm install && cd ../server && npm install && cd ..",
		"test": "sh ./scripts/e2e.sh"
	},
	"devDependencies": {
		"@eslint/js": "^9.13.0",
		"@stylistic/eslint-plugin": "^2.9.0",
		"@types/mocha": "^10.0.6",
		"@types/node": "^22",
		"eslint": "^9.13.0",
		"mocha": "^10.3.0",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.39.0"
	},
	"dependencies": {
		"xlsx": "^0.18.5"
	}
}
