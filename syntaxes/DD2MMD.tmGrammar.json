{
  "scopeName": "source.DD2MMD",
  "patterns": [{ "include": "#expression" }],
  "repository": {
		"expression": {
			"patterns": [
				{
					"name": "comment.line.dd2mmd",
					"match": "^\/\/.*|^#.*"
				},
				{
					"name": "meta.separator.comma.dd2mmd",
					"match": ","
				},
				{
					"name": "keyword.control.start.dd2mmd",
					"match": "^element_start"
				},
				{
					"name": "keyword.control.end.dd2mmd",
					"match": "^element_end"
				},
				{
					"name": "entity.name.element-id.dd2mmd",
					"match": "(?<=^element_start,)[^,]+(?=,)"
				},
				{
					"name": "entity.name.element-type.dd2mmd",
					"match": "(?<=^element_start,[^,]+,)[^,]+$"
				},
				{
					"name": "variable.language.dd2mmd",
					"match": "^[^,]*"
				},
				{
					"name": "constant.language.boolean.dd2mmd",
					"match": "\\b(True|False)\\b"
				},
				{
					"name": "constant.numeric.dd2mmd",
					"match": "[+-]?\\d+(?:\\.\\d+)?"
				},
				{
					"name": "constant.numeric.range.dd2mmd",
					"match": "\\[\\d+-\\d+\\]"
				},
				{
					"name": "variable.parameter.dd2mmd",
					"match": "(?<=,)[^,]+"
				}
			]
		}
  }
}
